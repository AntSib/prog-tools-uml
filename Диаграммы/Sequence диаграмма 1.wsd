@startuml sequence_AddNewWebService

' ==============================
' ACTORS & PARTICIPANTS
' ==============================

actor "Системный администратор" as admin
entity "Платформа" as Repo
entity "Runner" as Runner
database "Хранилище образов" as ImgStorage

' ==============================
' MAIN FLOW
' ==============================
title Добавление нового веб сервиса
autonumber

admin -> Repo: Настроить шаблон репозитория

activate admin
activate Repo

admin -> Repo: Создать/Настроить шаблон CI

admin -> Repo: Создать/Настроить шаблон CD

Repo -> Repo : Включить CI в пайплайн проекта
Repo -> Repo : Включить CD в пайплайн проекта

admin -> Repo: Добавление файлов проекта

deactivate admin

Repo -> Runner: Запуск пайплайна

activate Runner

' ========================================================
' ALTERNATIVE FLOW: Изменение CD во время работы пайплайна
' ========================================================

note right of Repo : Если тестирование проекта проходит\nно требуется изменение конфигурации CD

alt Администратор решает изменить CI/CD
    admin -> Repo: Обновить конфигурацию CI/CD
    
    note right of Repo : Репозиторий получает новые\nнастройки и готов к перезапуску

    Repo -> Runner: Перезапуск задачи
    Runner -> Runner : Тестирование проекта с новыми настройками
    
end

' ==============================
' TESTING FLOW
' ==============================

note left of Runner : Если на шаге CI вызвана ошибка\nдо создания образа

alt Успешное тестирование

    Runner -> Runner : Тестирование проекта

else Не успешеное тестироварие
    Runner -> Repo: Ошибка на шаге тестирования
    Repo -> admin: Отправить отчет об ошибке CI
    
    note right of admin: Анализ отчета ошибки CI\nКорректировка конфигурации CI
    
    admin -> Repo : Обновление конфигурации CI

    Repo -> Runner: Перезапустить задачу CI
    Runner -> Runner : Тестирование

end


alt Успешная сборка образа
    Runner -> Runner: Создать образа
    activate ImgStorage
    Runner -> ImgStorage: Отправить образ в хранилище
    ImgStorage --> Runner : Подтверждение сохранения образа
    deactivate ImgStorage
else Ошибка сборки
    Runner -> Repo: Ошибка на шаге сборки
    deactivate Runner
    Repo -> admin: Отправить отчет об ошибке сборки
    note right of admin: Анализ отчета ошибки\nКорректировка конфигурации CI
end


Runner --> Repo : Завершение потока
deactivate Runner

@enduml
